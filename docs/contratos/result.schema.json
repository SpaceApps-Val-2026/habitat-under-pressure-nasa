{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://habitat-under-pressure/contracts/result.schema.json",
  "title": "Step result",
  "description": "The only source of figures for the panel, the report and the assistant. It carries data or an absence, never both.",
  "type": "object",
  "required": ["id", "analysis", "step", "type", "variable", "data_class", "sources", "method"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "analysis": { "$ref": "common.schema.json#/$defs/id" },
    "step": { "$ref": "common.schema.json#/$defs/id" },
    "type": { "enum": ["value", "series", "layer", "table", "document"] },
    "variable": { "$ref": "common.schema.json#/$defs/id" },
    "zone": { "type": "string" },
    "period": { "$ref": "common.schema.json#/$defs/period" },
    "data_class": { "$ref": "common.schema.json#/$defs/data_class" },
    "unit": { "type": "string" },
    "value": { "type": "number" },
    "interval": {
      "type": "object",
      "required": ["level", "low", "high"],
      "additionalProperties": false,
      "properties": {
        "level": { "description": "0.95 means 95 %", "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 },
        "low": { "type": "number" },
        "high": { "type": "number" },
        "method": { "type": "string" }
      }
    },
    "direction_assertable": {
      "description": "false when the interval includes both improving and worsening: no central figure is given",
      "type": "boolean"
    },
    "statistic": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "value": { "type": "number" },
        "p": { "type": "number", "minimum": 0, "maximum": 1 },
        "p_adjusted": { "type": "number", "minimum": 0, "maximum": 1 },
        "n": { "type": "integer", "minimum": 0 }
      }
    },
    "series": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t"],
        "additionalProperties": false,
        "properties": {
          "t": { "type": "string" },
          "v": { "type": ["number", "null"] },
          "low": { "type": "number" },
          "high": { "type": "number" },
          "data_class": { "$ref": "common.schema.json#/$defs/data_class" },
          "scenario": { "type": "string" },
          "model": { "description": "Climate model or ensemble member the value comes from", "type": "string" }
        }
      }
    },
    "layer": {
      "type": "object",
      "required": ["path", "format"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "format": { "enum": ["cog", "pmtiles", "geojson", "png"] },
        "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "scale": { "description": "Name of the design-system scale", "type": "string" }
      }
    },
    "table": {
      "type": "object",
      "required": ["columns", "rows"],
      "properties": { "columns": { "type": "array" }, "rows": { "type": "array" } }
    },
    "document": {
      "type": "object",
      "required": ["quote"],
      "properties": { "quote": { "description": "Literal quote", "type": "string" } }
    },
    "absence": { "$ref": "common.schema.json#/$defs/absence" },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "valid_pct": { "type": "number", "minimum": 0, "maximum": 100 },
        "n_dates": { "type": "integer", "minimum": 0 }
      }
    },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/source_ref" } },
    "method": {
      "type": "object",
      "required": ["operation", "version"],
      "additionalProperties": false,
      "properties": {
        "operation": { "type": "string" },
        "version": { "type": "string" },
        "params": { "type": "object" }
      }
    },
    "limits": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/text" } },
    "evidence_level": {
      "description": "Sets the verbs a sentence may use. Never above the level of the operation; the statistical reviewer can lower it.",
      "$ref": "common.schema.json#/$defs/evidence_level"
    },
    "support": { "$ref": "common.schema.json#/$defs/support" },
    "diagnostics": {
      "description": "What the statistical reviewer reads: tests run, correction applied, autocorrelation, pre-trend in the control...",
      "type": "object",
      "additionalProperties": { "type": ["number", "boolean", "string"] }
    },
    "fingerprint": {
      "description": "sha256 of operation, version, params and input fingerprints. Same fingerprint, same result: the step cache key.",
      "$ref": "common.schema.json#/$defs/sha256"
    }
  },
  "oneOf": [
    {
      "required": ["absence"],
      "not": { "anyOf": [
        { "required": ["value"] }, { "required": ["series"] }, { "required": ["layer"] },
        { "required": ["table"] }, { "required": ["document"] }
      ] }
    },
    {
      "not": { "required": ["absence"] },
      "anyOf": [
        { "required": ["value", "unit"] }, { "required": ["series", "unit"] }, { "required": ["layer"] },
        { "required": ["table"] }, { "required": ["document"] }
      ]
    }
  ]
}
