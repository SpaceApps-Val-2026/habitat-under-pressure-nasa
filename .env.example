# Copy this file to .env and fill in only the keys you have. Git ignores .env; this example carries no values.
# Everything is optional: with an empty .env the application runs without a language model or accounts.

# Data folder (manifest, analyses, cache). Empty = <repo>/data. Set a path if the data live on another disk.
HUP_DATA_DIR=

# Jev (TypeSafe AI): typed reading of the question for the pre-filter. Optional.
TYPESAFE_API_KEY=

# LLM providers: one is enough; with both, the second is the fallback.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# NASA Earthdata user token, for sources that need an account (daily GPM IMERG). Optional; without it those
# sources return an explicit absence. Generate it in your Earthdata profile; it lasts 60 days.
EARTHDATA_TOKEN=

# Webhook of the team's Discord channel for agent messages. Optional; the URL is a secret.
DISCORD_WEBHOOK_AGENTE=

# Provider (openai, anthropic or none) and one model per task. These are not secrets.
# With a provider and no models set, the code uses its default model.
HUP_LLM_PROVIDER=none
HUP_LLM_MODEL_PLAN=
HUP_LLM_MODEL_TEXT=
HUP_LLM_MODEL_SMALL=

# From question to plan. Empty = default. These are not secrets.
# llm = one small typed call (task `understand`, small model) to read the question; empty = rules only.
HUP_UNDERSTAND=
# Empty = jev when TYPESAFE_API_KEY is set (typed reading, short list and a fast path with no planning call),
# lexical otherwise; `lexical` or `off` (whole catalogue) always win when written.
HUP_PREFILTER=
# off = do not reuse the plans of questions already asked.
HUP_QUESTION_CACHE=

# Deployment on a mounted bucket (Cloud Run). Empty or 0 = a normal local disk.
# Local folder for the events of the running analysis; copied to the data folder at most once a second and at the end.
HUP_EVENTS_LOCAL_DIR=
# 1 = every new line of the manifest and of the request log goes to its own small file.
HUP_SPLIT_APPENDS=0

# Limits for a public URL. Empty = no limit. Reference values for a demo: 10, 3, 10 and 1.
# Maximum LLM spend per UTC day (USD); when reached, the assistant and the writer switch to their rule-based paths.
HUP_LLM_DAILY_BUDGET_USD=
# Analyses running at once; the next one gets 429 busy.
HUP_MAX_RUNNING_ANALYSES=
# POST /api/plans and POST /api/analyses per visitor and minute (each route counted apart); 429 rate_limited.
HUP_RATE_LIMIT_PER_MINUTE=
# 1 = the visitor is the first address of X-Forwarded-For (only behind a proxy, such as Cloud Run).
HUP_TRUST_FORWARDED_FOR=0
